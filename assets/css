/* ===============================
   RESET & BASE
================================ */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, sans-serif;
  background: #111;
  color: #eee;
  padding-bottom: 80px;
}

h2, h3, h4 {
  margin-bottom: 10px;
}

input, select, textarea, button {
  font-size: 16px;
}

textarea {
  width: 100%;
  min-height: 80px;
  resize: vertical;
}

/* ===============================
   HEADER
================================ */
#mainHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #222;
  padding: 10px 15px;
  border-bottom: 1px solid #333;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabBtn {
  background: #333;
  border: 1px solid #444;
  padding: 8px 14px;
  border-radius: 6px;
  color: #ddd;
  cursor: pointer;
}

.tabBtn:hover {
  background: #444;
}

#btnRefresh {
  background: #333;
  border: 1px solid #555;
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
}

/* ===============================
   PANELS
================================ */
.panel {
  background: #1a1a1a;
  border: 1px solid #333;
  padding: 15px;
  margin: 15px;
  border-radius: 8px;
}

.row {
  display: flex;
  gap: 10px;
  margin: 10px 0;
}

.badge {
  background: #333;
  padding: 8px 12px;
  border-radius: 6px;
  margin-top: 10px;
}

/* ===============================
   BUTTONS
================================ */
button {
  background: #444;
  border: 1px solid #666;
  padding: 8px 14px;
  border-radius: 6px;
  color: #eee;
  cursor: pointer;
}

button:hover {
  background: #555;
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ===============================
   PILLS
================================ */
.pill {
  margin-top: 10px;
  padding: 6px 10px;
  border-radius: 6px;
  background: #333;
  color: #ccc;
}

.pill.ok {
  background: rgba(31,211,107,.25);
  border: 1px solid rgba(31,211,107,.6);
  color: #bdf6d2;
}

.pill.bad {
  background: rgba(255,59,48,.22);
  border: 1px solid rgba(255,59,48,.6);
  color: #ffd0cd;
}

/* ===============================
   STATUS
================================ */
.status {
  margin-top: 10px;
  padding: 6px 10px;
  border-radius: 6px;
  background: #333;
  color: #ccc;
}

.status.ok {
  background: rgba(31,211,107,.25);
  border: 1px solid rgba(31,211,107,.6);
  color: #bdf6d2;
}

/* ===============================
   MISSIONS
================================ */
.checkRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #333;
}

.checkRow .title {
  font-weight: 500;
}

.decSel {
  width: 100%;
  padding: 6px;
  border-radius: 6px;
  border: 1px solid #555;
  background: #222;
  color: #ddd;
}

.justifRow {
  margin-top: 8px;
  width: 100%;
}

.justifInp {
  width: 100%;
  padding: 6px;
  border-radius: 6px;
  border: 1px solid #555;
  background: #222;
  color: #ddd;
}

/* ===============================
   OVERLAY "DONE"
================================ */
#doneOverlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.85);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 200;
}

#doneOverlay.show {
  display: flex;
}

#doneImg {
  width: 60%;
  max-width: 400px;
  opacity: 0.95;
}

/* ===============================
   TOASTS
================================ */
.toast {
  position: fixed;
  left: 50%;
  bottom: 20px;
  transform: translateX(-50%);
  background: #222;
  border: 1px solid #444;
  padding: 10px 15px;
  border-radius: 6px;
  color: #eee;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s;
  z-index: 300;
}

.toast.show {
  opacity: 1;
}

/* ===============================
   VIEWS
================================ */
.view {
  display: none;
}

#viewAgents,
#viewAdmins {
  display: none;
}

/* ===============================
   RESPONSIVE
================================ */
@media (max-width: 600px) {
  .row {
    flex-direction: column;
  }

  #doneImg {
    width: 80%;
  }
}
